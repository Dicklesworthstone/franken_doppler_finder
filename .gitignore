# Rust build output
/target/
target/
**/*.rs.bk
*.pdb

# Keep Cargo.lock tracked: fdop is a binary, and a pinned lock keeps runs reproducible.

# Profiling and benchmark scratch
*.profraw
*.profdata
perf.data
perf.data.old
flamegraph.svg

# === franken_doppler_finder specific ===

# Run directories written by `fdop locate | detect | selftest` (default ./fdop_runs/ under the working
# directory, so match it at any depth), plus the older top-level layout.
fdop_runs/
/runs/
*.fspec

# Downloaded data never belongs in git. ADS-B day stores, terrain and map tiles, gazetteer zips, weather
# responses and the run ledger live under the cache root ($FDOP_CACHE, default ~/.cache/fdop); this keeps
# stray copies out of the tree too.
/cache/
*.fdtrk
*.fdtrk.part
runs.sqlite
runs.sqlite-*

# Recordings. This tool infers where a recording was made, so a committed recording can leak a location.
# Tests synthesise their audio; real recordings stay outside the repository. The patterns are case-insensitive
# (CLIP.MP4 as well as clip.mp4), because git matches case-sensitively on Linux.
*.[mM]4[aA]
*.[mM][pP]3
*.[wW][aA][vV]
*.[fF][lL][aA][cC]
*.[oO][gG][gG]
*.[oO][pP][uU][sS]
*.[aA][aA][cC]
*.[mM][pP]4
*.[mM][oO][vV]
*.[mM][kK][vV]
*.[wW][eE][bB][mM]

# Secrets (GITHUB_TOKEN and friends belong in the environment, never in a file here)
.env
.env.*

# Agent and tool state
.ee/
.ntm/
.rch/
.bv/
.beads/beads.db*
.beads/*.lock

# OS / editor
.DS_Store
.idea/
.vscode/

# rustc internal-compiler-error dumps
rustc-ice-*.txt
